{
  "name": "sistema-nomina-pro",
  "version": "1.0.0",
  "description": "Sistema de Nómina Profesional con Base de Datos Embebida",
  "main": "electron/main.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && xcopy src\\generated dist\\generated /E /I /Y && xcopy src\\database dist\\database /E /I /Y",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5000 && electron .\"",
    "dist": "npm run build && electron-builder",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/prisma/schema.prisma"
  },
  "build": {
    "appId": "com.empresa.nomina",
    "productName": "Sistema de Nómina",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "src/prisma/**/*",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "frontend-build/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "frontend-build/**/*",
      "src/prisma/schema.prisma",
      "package.json",
      "node_modules/**/*",
      "node_modules/.prisma/**/*"
    ],
    "extraResources": [
      {
        "from": "postgres-portable",
        "to": "postgres-portable",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend-build",
        "to": "app.asar.unpacked/frontend-build"
      }
    ],
    "win": {
      "target": "nsis",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "nomina",
    "electron",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "SysNomina PRO Corp",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "prisma": "^6.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "wait-on": "^9.0.3"
  }
}