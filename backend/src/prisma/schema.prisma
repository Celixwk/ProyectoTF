  hora_salida      DateTime  @map("hora_salida") @db.Time(6)
  tipo_turno       String    @map("tipo_turno") @db.VarChar(50)
  thl              Decimal?  @map("thl") @db.Decimal(8, 2)
  id_area          Int       @map("id_area")
  nombre_area      String    @map("nombre_area") @db.VarChar(100)
  id_labor_mes     Int       @map("id_labor_mes")
  id_empleado      Int       @map("id_empleado")
  nombre_completo  String    @map("nombre_completo")
  cedula           String    @map("cedula") @db.VarChar(20)
  nombre_cargo     String    @map("nombre_cargo") @db.VarChar(100)
  salario_base     Decimal   @map("salario_base") @db.Decimal(12, 2)
  created_at       DateTime? @map("created_at") @db.Timestamp(6)
  updated_at       DateTime? @map("updated_at") @db.Timestamp(6)

  @@map("vw_turnos_asignados")
}

view VwNovedadesCompletas {
  id_novedad_registro Int       @map("id_novedad_registro")
  fecha_solicitud     DateTime  @map("fecha_solicitud") @db.Date
  fecha_registro      DateTime  @map("fecha_registro") @db.Date
  fecha_vencimiento   DateTime? @map("fecha_vencimiento") @db.Date
  etapa               String?   @map("etapa") @db.VarChar(50)
  id_empleado         Int       @map("id_empleado")
  empleado            String    @map("empleado")
  cedula              String    @map("cedula") @db.VarChar(20)
  nombre_cargo        String    @map("nombre_cargo") @db.VarChar(100)
  id_novedad_tipo     Int?      @map("id_novedad_tipo")
  codigo_novedad      String?   @map("codigo_novedad") @db.VarChar(20)
  tipo                String?   @map("tipo") @db.VarChar(100)
  afecta_pago         Boolean?  @map("afecta_pago")
  fecha_inicio        DateTime? @map("fecha_inicio") @db.Date
  cantidad            Decimal?  @map("cantidad") @db.Decimal(10, 2)
  observaciones       String?   @map("observaciones")
  usuario_registro    String    @map("usuario_registro") @db.VarChar(150)
  created_at          DateTime? @map("created_at") @db.Timestamp(6)
  updated_at          DateTime? @map("updated_at") @db.Timestamp(6)

  @@map("vw_novedades_completas")
}

view VwRecargosCompletos {
  id_recargo       Int       @map("id_recargo")
  fecha_inicio     DateTime  @map("fecha_inicio") @db.Date
  fecha_fin        DateTime  @map("fecha_fin") @db.Date
  total_horas      Decimal?  @map("total_horas") @db.Decimal(8, 2)
  total_dinero     Decimal?  @map("total_dinero") @db.Decimal(12, 2)
