generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cargo {
  id_cargo     Int        @id @default(autoincrement())
  nombre_cargo String     @db.VarChar(100)
  salario_base Decimal    @db.Decimal(12, 2)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @updatedAt @db.Timestamp(6)
  empleados    Empleado[]

  @@map("cargo")
}

model Area {
  id_area              Int                   @id @default(autoincrement())
  nombre_area          String                @db.VarChar(100)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  updated_at           DateTime?             @default(now()) @updatedAt @db.Timestamp(6)
  detalle_programacion DetalleProgramacion[]

  @@map("area")
}

model Turno {
  id_turno             Int                   @id @default(autoincrement())
  codigo               String                @unique @db.VarChar(20)
  hora_entrada         DateTime              @db.Time(6)
  hora_salida          DateTime              @db.Time(6)
  tipo_turno           String                @db.VarChar(50)
  estado               Boolean?              @default(true)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  updated_at           DateTime?             @default(now()) @updatedAt @db.Timestamp(6)
  detalle_programacion DetalleProgramacion[]

  @@map("turno")
}

model TipoNovedad {
  id_novedad_tipo Int              @id @default(autoincrement())
  codigo          String           @unique @db.VarChar(20)
  nombre_novedad  String           @db.VarChar(100)
  afecta_pago     Boolean          @default(false)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  updated_at      DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  detalle_novedad DetalleNovedad[]

  @@map("tipo_novedad")
}

model TipoRecargo {
  id_tipo_recargo    Int              @id @default(autoincrement())
  codigo             String           @unique @db.VarChar(20)
  nombre_recargo     String           @db.VarChar(100)
  porcentaje_recargo Decimal          @db.Decimal(5, 2)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  detalle_recargo    DetalleRecargo[]

  @@map("tipo_recargo")
}

model Parametrizacion {
  id_parametro          Int       @id @default(autoincrement())
  nombre_parametro      String    @unique @db.VarChar(100)
  valor_numerico        Decimal?  @db.Decimal(10, 2)
  valor_texto           String?   @db.Text
  descripcion           String?
  tipo_parametro        String?   @db.VarChar(50)
  categoria             String?   @db.VarChar(50)
  activo                Boolean?  @default(true)
  fecha_vigencia_inicio DateTime? @db.Date
  fecha_vigencia_fin    DateTime? @db.Date
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@index([activo], map: "idx_parametrizacion_activo")
  @@index([categoria], map: "idx_parametrizacion_categoria")
  @@map("parametrizacion")
}

model Calendario {
  id_calendario  Int       @id @default(autoincrement())
  fecha          DateTime  @unique @db.Date
  es_festivo     Boolean?  @default(false)
  es_domingo     Boolean?  @default(false)
  nombre_festivo String?   @db.VarChar(100)
  tipo_festivo   String?   @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@index([fecha], map: "idx_calendario_fecha")
  @@index([es_festivo], map: "idx_calendario_festivo")
  @@map("calendario")
}

model Empleado {
  id_empleado      Int               @id @default(autoincrement())
  nombre1          String            @db.VarChar(50)
  nombre2          String?           @db.VarChar(50)
  apellido1        String            @db.VarChar(50)
  apellido2        String?           @db.VarChar(50)
  cedula           String            @unique @db.VarChar(20)
  edad             Int?
  sexo             String?           @db.Char(1)
  vehiculo         String?           @db.VarChar(20)
  estado           Boolean?          @default(true)
  id_cargo         Int
  areas_permitidas Json?
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  cargo            Cargo             @relation(fields: [id_cargo], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction)
  labor_mes        LaborMes[]
  novedad_empleado NovedadEmpleado[]
  usuario          Usuario?

  @@index([id_cargo], map: "idx_empleado_cargo")
  @@index([estado], map: "idx_empleado_estado")
  @@index([cedula], map: "idx_empleado_cedula")
  @@map("empleado")
}

model Usuario {
  id_usuario       Int               @id @default(autoincrement())
  usuario          String            @unique @db.VarChar(50)
  contrasenia      String            @db.VarChar(255)
  tipo_usuario     String            @db.VarChar(50)
  nombre_completo  String            @db.VarChar(150)
  estado           Boolean?          @default(true)
  fecha_creacion   DateTime          @db.Date
  id_empleado      Int?              @unique
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  novedad_empleado NovedadEmpleado[]
  empleado         Empleado?         @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)

  @@map("usuario")
}

model LaborMes {
  id                   Int                   @id @default(autoincrement())
  fecha_inicio         DateTime              @db.Date
  fecha_fin            DateTime              @db.Date
  horas_ordinarias     Decimal?              @default(0) @db.Decimal(8, 2)
  total_horas          Decimal?              @default(0) @db.Decimal(8, 2)
  total_recargos       Decimal?              @default(0) @db.Decimal(12, 2)
  id_empleado          Int
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  updated_at           DateTime?             @default(now()) @updatedAt @db.Timestamp(6)
  detalle_programacion DetalleProgramacion[]
  empleado             Empleado              @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_empleado, fecha_inicio, fecha_fin])
  @@index([id_empleado], map: "idx_labor_mes_empleado")
  @@index([fecha_inicio, fecha_fin], map: "idx_labor_mes_fechas")
  @@map("labor_mes")
}

model NovedadEmpleado {
  id_novedad_registro Int              @id @default(autoincrement())
  fecha_solicitud     DateTime         @db.Date
  fecha_registro      DateTime         @db.Date
  fecha_vencimiento   DateTime?        @db.Date
  etapa               String?          @default("pendiente") @db.VarChar(50)
  id_usuario          Int
  id_empleado         Int
  created_at          DateTime?        @default(now()) @db.Timestamp(6)
  updated_at          DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  detalle_novedad     DetalleNovedad[]
  empleado            Empleado         @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  usuario             Usuario          @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_usuario], map: "idx_novedad_usuario")
  @@index([id_empleado], map: "idx_novedad_empleado")
  @@index([etapa], map: "idx_novedad_etapa")
  @@map("novedad_empleado")
}

model DetalleProgramacion {
  id_detalle_turno      Int       @id @default(autoincrement())
  fecha                 DateTime  @db.Date
  id_area               Int
  total_horas_laboradas Decimal?  @default(0) @db.Decimal(8, 2)
  fk_id_labor_mes       Int
  fk_id_turno           Int
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  labor_mes             LaborMes  @relation(fields: [fk_id_labor_mes], references: [id], onDelete: NoAction, onUpdate: NoAction)
  turno                 Turno     @relation(fields: [fk_id_turno], references: [id_turno], onDelete: NoAction, onUpdate: NoAction)
  area                  Area      @relation(fields: [id_area], references: [id_area], onDelete: NoAction, onUpdate: NoAction)
  recargo               Recargo[]

  @@index([fk_id_labor_mes], map: "idx_detalle_programacion_labor")
  @@index([fecha], map: "idx_detalle_programacion_fecha")
  @@map("detalle_programacion")
}

model DetalleNovedad {
  id_detalle_novedad  Int             @id @default(autoincrement())
  fecha               DateTime        @db.Date
  cantidad            Decimal?        @db.Decimal(10, 2)
  observaciones       String?
  id_novedad_registro Int
  id_novedad_tipo     Int
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  updated_at          DateTime?       @default(now()) @updatedAt @db.Timestamp(6)
  novedad_empleado    NovedadEmpleado @relation(fields: [id_novedad_registro], references: [id_novedad_registro], onDelete: NoAction, onUpdate: NoAction)
  tipo_novedad        TipoNovedad     @relation(fields: [id_novedad_tipo], references: [id_novedad_tipo], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_novedad_registro], map: "idx_detalle_novedad_registro")
  @@map("detalle_novedad")
}

model Recargo {
  id_recargo           Int                 @id @default(autoincrement())
  total_horas          Decimal?            @default(0) @db.Decimal(8, 2)
  total_dinero         Decimal?            @default(0) @db.Decimal(12, 2)
  dominicales          Int?                @default(0)
  festivos             Int?                @default(0)
  rno                  Decimal?            @default(0) @db.Decimal(8, 2)
  rnf                  Decimal?            @default(0) @db.Decimal(8, 2)
  heon                 Decimal?            @default(0) @db.Decimal(8, 2)
  heod                 Decimal?            @default(0) @db.Decimal(8, 2)
  hefd                 Decimal?            @default(0) @db.Decimal(8, 2)
  hefn                 Decimal?            @default(0) @db.Decimal(8, 2)
  fecha_inicio         DateTime            @db.Date
  fecha_fin            DateTime            @db.Date
  fk_id_detalle_turno  Int
  created_at           DateTime?           @default(now()) @db.Timestamp(6)
  updated_at           DateTime?           @default(now()) @updatedAt @db.Timestamp(6)
  detalle_recargo      DetalleRecargo[]
  detalle_programacion DetalleProgramacion @relation(fields: [fk_id_detalle_turno], references: [id_detalle_turno], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_id_detalle_turno], map: "idx_recargo_detalle_turno")
  @@map("recargo")
}

model DetalleRecargo {
  id_recargo      Int
  id_tipo_recargo Int
  cantidad        Decimal     @db.Decimal(10, 2)
  valor_calculado Decimal?    @db.Decimal(12, 2)
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  updated_at      DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  recargo         Recargo     @relation(fields: [id_recargo], references: [id_recargo], onDelete: NoAction, onUpdate: NoAction)
  tipo_recargo    TipoRecargo @relation(fields: [id_tipo_recargo], references: [id_tipo_recargo], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_recargo, id_tipo_recargo])
  @@map("detalle_recargo")
}

model AuditoriaLaborMes {
  id_auditoria              Int       @id @default(autoincrement())
  id_labor_mes              Int
  accion                    String    @db.VarChar(10)
  id_empleado_anterior      Int?
  id_empleado_nuevo         Int?
  fecha_inicio_anterior     DateTime? @db.Date
  fecha_inicio_nueva        DateTime? @db.Date
  fecha_fin_anterior        DateTime? @db.Date
  fecha_fin_nueva           DateTime? @db.Date
  horas_ordinarias_anterior Decimal?  @db.Decimal(8, 2)
  horas_ordinarias_nueva    Decimal?  @db.Decimal(8, 2)
  total_horas_anterior      Decimal?  @db.Decimal(8, 2)
  total_horas_nueva         Decimal?  @db.Decimal(8, 2)
  total_recargos_anterior   Decimal?  @db.Decimal(12, 2)
  total_recargos_nueva      Decimal?  @db.Decimal(12, 2)
  usuario_modificacion      String?   @db.VarChar(100)
  ip_modificacion           String?   @db.VarChar(45)
  fecha_modificacion        DateTime? @default(now()) @db.Timestamp(6)
  observaciones             String?

  @@index([id_labor_mes], map: "idx_audit_labor_mes")
  @@index([fecha_modificacion], map: "idx_audit_labor_fecha")
  @@index([usuario_modificacion], map: "idx_audit_labor_usuario")
  @@map("auditoria_labor_mes")
}

